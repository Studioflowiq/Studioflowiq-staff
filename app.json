{
  "expo": {
    "name": "VayHaven Management",
    "slug": "vayhaven-management",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "vayhaven-management",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vayhaven.management",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Take a photo for a property, work order or service request.",
        "NSPhotoLibraryUsageDescription": "Attach photos to VayHaven property and service records."
      }
    },
    "android": {
      "package": "com.vayhaven.management",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#07348f"
      },
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "./plugins/with-local-notifications.js",
      "expo-notifications"
    ],
    "extra": {
      "website": "https://vayhaven.com",
      "appVariant": "management"
    }
  }
}
