{
  "expo": {
    "name": "StudioFlowIQ",
    "slug": "studioflowiq-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "studioflowiq",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.studioflowiq.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Scan a member\u2019s StudioFlowIQ check-in pass using the camera.",
        "NSPhotoLibraryUsageDescription": "Choose a photo for your StudioFlowIQ profile."
      }
    },
    "android": {
      "package": "com.studioflowiq.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#16292e"
      },
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "expo-notifications",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow StudioFlowIQ to scan member check-in passes.",
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo for your StudioFlowIQ profile.",
          "cameraPermission": "Take a photo for your StudioFlowIQ profile.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "supportEmail": "hello@studioflowiq.com",
      "website": "https://studioflowiq.com"
    }
  }
}
